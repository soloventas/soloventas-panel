// Esquema de base de datos — Etapa 1 (MVP)
// Cubre: usuario del panel, catálogo de productos con variantes,
// y el contenido que generará el equipo de marketing / revisará el de calidad.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  nombre       String
  passwordHash String
  createdAt    DateTime @default(now())
}

// Categorías propias del catálogo (Gorras, Accesorios, etc.), para
// dividir los productos y poder filtrarlos/agruparlos.
model Categoria {
  id        String     @id @default(cuid())
  nombre    String     @unique
  createdAt DateTime   @default(now())
  productos Producto[]
}

// Tabla de colores disponibles para variantes de productos (código + nombre).
model Color {
  id        String             @id @default(cuid())
  codigo    String             @unique
  nombre    String
  createdAt DateTime           @default(now())
  variantes VarianteProducto[]
}

// Tabla de talles disponibles para variantes de productos (código + nombre).
model Talle {
  id        String             @id @default(cuid())
  codigo    String             @unique
  nombre    String
  createdAt DateTime           @default(now())
  variantes VarianteProducto[]
}

enum Moneda {
  ARS
  USD
}

model Producto {
  id          String     @id @default(cuid())
  codigo      String     @unique // alfanumérico, único (ej: G9012B)
  nombre      String
  descripcion String?
  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  // Si queda vacío, se considera producto propio (sin proveedor externo).
  proveedor String?

  // Precios: costo + ganancia % informan el precio de venta, pero el
  // precio de venta final queda como el valor que se usa en el catálogo.
  // Regla: el precio de venta no puede ser menor al costo.
  precioCosto        Decimal? @db.Decimal(12, 2)
  gananciaPorcentaje Decimal? @db.Decimal(6, 2)
  precio             Decimal  @db.Decimal(12, 2) // precio de venta final
  moneda             Moneda   @default(ARS)

  // Si no admite color ni talle, se usa este stock general del producto.
  admiteColor Boolean @default(false)
  admiteTalle Boolean @default(false)
  stock       Int?    @default(0)

  compraMinima Decimal @default(1) @db.Decimal(10, 3) // admite fracción

  // Descuento por cantidad: a partir de "descuentoCantidadMinima"
  // unidades, se aplica "descuentoPorcentaje" % de descuento.
  descuentoCantidadMinima Int?
  descuentoPorcentaje     Decimal? @db.Decimal(5, 2)

  visibleSinRegistrarse Boolean @default(true)
  enOferta              Boolean @default(false)
  esNuevo               Boolean @default(true)
  activo                Boolean @default(true)

  imagenUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variantes     VarianteProducto[]
  contenido     ContenidoGenerado[]
  media         MediaProducto[]
  publicaciones Publicacion[]
  trabajosIA    TrabajoIA[]
}

// Cada combinación de color / talle con su propio stock.
// El color y el talle se eligen de las tablas Color / Talle.
model VarianteProducto {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  colorId    String?
  color      Color?   @relation(fields: [colorId], references: [id])
  talleId    String?
  talle      Talle?   @relation(fields: [talleId], references: [id])
  stock      Int      @default(0)

  @@unique([productoId, colorId, talleId])
}

enum TipoMedia {
  FOTO
  VIDEO
}

enum OrigenMedia {
  ORIGINAL
  IA
}

// Fotos (máx. 20) y videos (máx. 5) de cada producto, guardados en Vercel Blob.
// La foto con menor "orden" es la portada del producto.
model MediaProducto {
  id         String    @id @default(cuid())
  productoId String
  producto   Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo       TipoMedia
  url        String
  pathname   String
  nombre     String?
  tamano     Int?
  orden      Int       @default(0)
  // Lo generado con IA queda pendiente hasta que se aprueba; solo lo
  // aprobado se puede publicar o usar como portada.
  origen     OrigenMedia @default(ORIGINAL)
  aprobado   Boolean     @default(true)
  createdAt  DateTime  @default(now())

  @@index([productoId, tipo, orden])
}

// Fotos y videos que se piden a la IA en modo automático (fal.ai).
// Mientras la IA trabaja queda PENDIENTE; al terminar, el archivo se guarda
// como MediaProducto de origen IA, pendiente de aprobación.
model TrabajoIA {
  id          String    @id @default(cuid())
  productoId  String
  producto    Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo        TipoMedia
  modelo      String
  prompt      String
  statusUrl   String
  responseUrl String
  estado      String    @default("PENDIENTE") // PENDIENTE | LISTO | ERROR
  error       String?
  mediaId     String?
  createdAt   DateTime  @default(now())

  @@index([productoId, createdAt])
}

enum TipoContenido {
  IMAGEN
  VIDEO
  TEXTO
}

enum EstadoContenido {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Lo que produce el equipo de Marketing y revisa el equipo de Calidad.
// Por ahora se carga a mano; en la Etapa 1.1 lo va a completar el agente de IA.
model ContenidoGenerado {
  id         String          @id @default(cuid())
  productoId String
  producto   Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo       TipoContenido
  contenido  String // URL de la imagen/video, o el texto publicitario
  estado     EstadoContenido @default(PENDIENTE)
  notas      String? // motivo de rechazo, si corresponde
  createdAt  DateTime        @default(now())
  revisadoAt DateTime?
}

// ---------------------------------------------------------------------------
// Redes sociales
// ---------------------------------------------------------------------------

enum RedSocial {
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  TIKTOK
}

// Conexiones con las redes. "clave" identifica cada una:
// "meta_usuario" (permiso general de Meta), "facebook" (la página elegida),
// "instagram" (la cuenta profesional vinculada a esa página), etc.
model IntegracionRed {
  id          String    @id @default(cuid())
  clave       String    @unique
  nombre      String?
  externalId  String?
  accessToken String
  expiraEn    DateTime?
  extra       Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum FormatoPublicacion {
  FOTO
  CARRUSEL
  VIDEO
}

enum EstadoPublicacion {
  PROCESANDO
  PUBLICADA
  ERROR
}

// Cada publicación hecha desde el panel en una red.
model Publicacion {
  id          String             @id @default(cuid())
  productoId  String
  producto    Producto           @relation(fields: [productoId], references: [id], onDelete: Cascade)
  red         RedSocial
  formato     FormatoPublicacion
  texto       String
  mediaUrls   String[]
  estado      EstadoPublicacion  @default(PROCESANDO)
  contenedor  String? // id intermedio de Instagram mientras procesa el archivo
  externalId  String?
  permalink   String?
  error       String?
  createdAt   DateTime           @default(now())
  publicadaAt DateTime?

  @@index([productoId, createdAt])
}
